# Telegram Bot Token (BotFather dan olinadi)
BOT_TOKEN="your_bot_token_here"

# Admin Telegram ID (botga /start bosib bilib olasiz)
ADMIN_ID="your_telegram_id_here"

# Target kanal ID (masalan: @your_channel)
TARGET_CHANNEL_ID="@your_channel_here"

# Kanal havolasi (obuna tugmasi uchun)
CHANNEL_LINK="@your_channel_here"

# OpenRouter AI API kaliti (openrouter.ai dan olinadi)
OPENROUTER_API_KEY="sk-or-v1-your_key_here"
